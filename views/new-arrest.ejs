<!DOCTYPE html>
<html>
<head>
    <title>Register Arrest</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

    <h2 class="mb-4">🚔 Register New Arrest</h2>

    <form action="/arrests" method="POST">

        <div class="row">

            <div class="col-md-6 mb-3">
                <label>Arrest Number</label>
                <input
                    type="text"
                    class="form-control"
                    name="arrest_number"
                    value="<%= arrestNumber %>"
                    readonly>
            </div>

            <div class="col-md-6 mb-3">
                <label>Suspect Name</label>
                <input
                    type="text"
                    class="form-control"
                    name="suspect_name"
                    required>
            </div>

            <div class="col-md-6 mb-3">
                <label>National ID</label>
                <input
                    type="text"
                    class="form-control"
                    name="national_id">
            </div>

            <div class="col-md-6 mb-3">
                <label>Gender</label>

                <select
                    class="form-control"
                    name="gender">

                    <option>Male</option>
                    <option>Female</option>

                </select>

            </div>

            <div class="col-md-4 mb-3">
                <label>Age</label>

                <input
                    type="number"
                    class="form-control"
                    name="age">

            </div>

            <div class="col-md-4 mb-3">
                <label>Phone</label>

                <input
                    type="text"
                    class="form-control"
                    name="phone">

            </div>

            <div class="col-md-4 mb-3">
                <label>Offence</label>

                <input
                    type="text"
                    class="form-control"
                    name="offence"
                    required>

            </div>

            <div class="col-md-12 mb-3">
                <label>Address</label>

                <textarea
                    class="form-control"
                    name="address"></textarea>

            </div>

            <div class="col-md-6 mb-3">
                <label>Case Number</label>

                <select
                    class="form-control"
                    name="case_number">

                    <% cases.forEach(policeCase => { %>

                        <option value="<%= policeCase.case_number %>">
                            <%= policeCase.case_number %>
                        </option>

                    <% }) %>

                </select>

            </div>

            <div class="col-md-6 mb-3">
                <label>Arresting Officer</label>

                <select
                    class="form-control"
                    name="arresting_officer">

                    <% officers.forEach(officer => { %>

                        <option value="<%= officer.full_name %>">
                            <%= officer.full_name %>
                        </option>

                    <% }) %>

                </select>

            </div>

            <div class="col-md-6 mb-3">
                <label>Arrest Date</label>

                <input
                    type="date"
                    class="form-control"
                    name="arrest_date"
                    required>

            </div>

            <div class="col-md-6 mb-3">
                <label>Arrest Time</label>

                <input
                    type="time"
                    class="form-control"
                    name="arrest_time"
                    required>

            </div>

            <div class="col-md-6 mb-3">
                <label>Place of Arrest</label>

                <input
                    type="text"
                    class="form-control"
                    name="arrest_location">

            </div>

            <div class="col-md-6 mb-3">
                <label>Cell Number</label>

                <input
                    type="text"
                    class="form-control"
                    name="cell_number">

            </div>

            <div class="col-md-12 mb-3">
                <label>Remarks</label>

                <textarea
                    class="form-control"
                    name="remarks"></textarea>

            </div>

        </div>

        <button class="btn btn-primary">
            Save Arrest
        </button>

        <a href="/arrests" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

</body>
</html>