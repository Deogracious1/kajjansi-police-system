<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Forgot Password</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

</head>

<body class="bg-light">

<div class="container">

    <div class="row justify-content-center mt-5">

        <div class="col-md-6">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-primary text-white text-center">

                    <h3>
                        <i class="bi bi-shield-lock-fill"></i>
                        Password Recovery
                    </h3>

                </div>

                <div class="card-body text-center p-5">

                    <i class="bi bi-tools display-1 text-warning"></i>

                    <h3 class="mt-3">
                        Feature Under Maintenance
                    </h3>

                    <p class="text-muted mt-3">
                        The password recovery feature is currently unavailable.
                    </p>

                    <p class="text-muted">
                        Please contact the System Administrator if you need your password to be reset.
                    </p>

                    <a href="/login" class="btn btn-primary mt-3">
                        <i class="bi bi-arrow-left-circle"></i>
                        Back to Login
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

</body>

</html>