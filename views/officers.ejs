<!DOCTYPE html>
<html>
<head>
<title>Officers</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

<h2>Police Officers</h2>

<a href="/dashboard" class="btn btn-secondary mb-3">
Dashboard
</a>

<a href="/officers/new" class="btn btn-primary mb-3">
New Officer
</a>

<table class="table table-bordered">

<tr>
<th>Badge No.</th>
<th>Name</th>
<th>Rank</th>
<th>Phone</th>
<th>Department</th>
<th>Actions</th>
</tr>

<% officers.forEach(o => { %>

<tr>
<td><%= o.badge_number %></td>
<td>
<a href="/officers/<%= o.id %>">
    <%= o.full_name %>
</a>
</td>
<td><%= o.rank %></td>
<td><%= o.phone %></td>
<td><%= o.department %></td>

<td>
<a href="/officers/edit/<%= o.id %>"
class="btn btn-warning btn-sm">
Edit
</a>

<a href="/officers/delete/<%= o.id %>"
class="btn btn-danger btn-sm"
onclick="return confirm('Delete officer?')">
Delete
</a>
</td>
</tr>

<% }) %>

</table>

</div>

</body>
</html>