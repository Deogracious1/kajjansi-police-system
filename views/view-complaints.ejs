<!DOCTYPE html>
<html>
<head>
<title>Complaints</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">
<nav class="navbar navbar-dark bg-primary mb-4">
  <div class="container-fluid">
    <span class="navbar-brand">
      🚔 Kajjansi Police Management System
    </span>

    <div>
      <a href="/dashboard" class="btn btn-light me-2">
        Dashboard
      </a>

      <a href="/logout" class="btn btn-danger">
        Logout
      </a>
    </div>
  </div>
</nav>

<h2>Complaints List</h2>

<a href="/complaints" class="btn btn-primary mb-3">
New Complaint
</a>

<table class="table table-bordered">

<tr>
<th>ID</th>
<th>Name</th>
<th>Phone</th>
<th>Complaint</th>
<th>Date</th>
<th>Action</th>
</tr>

<% complaints.forEach(c => { %>

<tr>
<td><%= c.id %></td>
<td><%= c.name %></td>
<td><%= c.phone %></td>
<td><%= c.complaint %></td>
<td><%= c.created_at %></td>
<td>
    <a href="/complaints/edit/<%= c.id %>"
       class="btn btn-sm btn-warning">
       Edit
    </a>

    <a href="/complaints/delete/<%= c.id %>"
       class="btn btn-sm btn-danger"
       onclick="return confirm('Delete this complaint?')">
       Delete
    </a>
</td>
</tr>

<% }) %>

</table>

</div>

</body>
</html>