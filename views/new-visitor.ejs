<!DOCTYPE html>
<html>
<head>
    <title>Register Visitor</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>
<body>

<div class="container mt-5">

<h2>Register Visitor</h2>

<form action="/visitors" method="POST">

<div class="mb-3">
<label>Visitor Number</label>
<input
type="text"
name="visitor_number"
class="form-control"
value="<%= visitorNumber %>"
readonly>
</div>


<div class="mb-3">
<label>Full Name</label>
<input
type="text"
name="full_name"
class="form-control"
required>
</div>

<div class="mb-3">
<label>National ID</label>
<input
type="text"
name="national_id"
class="form-control">
</div>

<div class="mb-3">
<label>Phone Number</label>
<input
type="text"
name="phone"
class="form-control">
</div>

<div class="mb-3">
<label>Gender</label>

<select
name="gender"
class="form-control"
required>

<option value="">Select Gender</option>
<option>Male</option>
<option>Female</option>

</select>

</div>

<div class="mb-3">
<label>Address</label>

<input
type="text"
name="address"
class="form-control">

</div>

<script>

document.getElementById("time_in")
.addEventListener("change", function () {

    if (
        document.getElementById("visit_type").value
        === "Prisoner"
    ) {

        let time = this.value.split(":");

        let hour =
            parseInt(time[0]) + 1;

        let minute = time[1];

        if (hour < 10) {
            hour = "0" + hour;
        }

        document.getElementById("time_out").value =
            hour + ":" + minute;
    }
});

</script>
<div class="mb-3">
    <label>Visit Type</label>

    <select
        id="visit_type"
        name="visit_type"
        class="form-control"
        required>

        <option value="">Select</option>
        <option value="Officer">Police Officer</option>
        <option value="Prisoner">Prisoner</option>

    </select>
</div>

<div class="mb-3">
<label>Person to Visit</label>
<select
id="person_to_visit"
name="person_to_visit"
class="form-control"
required>
</select>

</div>

<div class="mb-3">
<label>Purpose of Visit</label>

<textarea
name="purpose"
class="form-control"
rows="3"
required></textarea>

</div>

<div class="mb-3">
<label>Date</label>

<input
type="date"
name="date"
class="form-control"
required>

</div>

<div class="mb-3">
<label>Time In</label>

<input
type="time"
id="time_in"
name="time_in"
class="form-control"
required>

</div>

<div class="mb-3">
<label>Time Out</label>

<input
type="time"
id="time_out"
name="time_out"
class="form-control"
readonly>

</div>

<div class="mb-3">
<label>Remarks</label>

<textarea
name="remarks"
class="form-control"
rows="3"></textarea>

</div>

<button class="btn btn-primary">
Save Visitor
</button>

<a href="/visitors"
class="btn btn-secondary">
Cancel
</a>

</form>
</div>
<script>
const visitType =
    document.getElementById("visit_type");

const personSelect =
    document.getElementById("person_to_visit");

const timeIn =
    document.getElementById("time_in");

const timeOut =
    document.getElementById("time_out");

const officers =
    <%- JSON.stringify(officers || []) %>;

const prisoners =
    <%- JSON.stringify(prisoners || []) %>;

visitType.addEventListener("change", function () {

    personSelect.innerHTML =
        '<option value="">Select Person</option>';

    if (this.value === "Officer") {

        officers.forEach((officer) => {
            personSelect.innerHTML +=
                `<option value="${officer.full_name}">
                    ${officer.full_name}
                </option>`;
        });

        timeOut.value = "";
        timeOut.readOnly = false;
    }

    if (this.value === "Prisoner") {

        prisoners.forEach((prisoner) => {
            personSelect.innerHTML +=
                `<option value="${prisoner.suspect_name}">
                    ${prisoner.suspect_name}
                </option>`;
        });

        timeOut.readOnly = true;
    }
});

timeIn.addEventListener("change", function () {

    if (
        visitType.value === "Prisoner" &&
        this.value
    ) {

        let parts = this.value.split(":");

        let date = new Date();

        date.setHours(parseInt(parts[0]));
        date.setMinutes(parseInt(parts[1]));

        date.setHours(date.getHours() + 1);

        let hours =
            String(date.getHours()).padStart(2, "0");

        let minutes =
            String(date.getMinutes()).padStart(2, "0");

        timeOut.value =
            hours + ":" + minutes;
    }
});
</script>
</body>
</html>