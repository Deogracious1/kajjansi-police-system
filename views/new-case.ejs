<!DOCTYPE html>
<html>
<head>
<title>New Case</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

<h2>Register New Case</h2>

<form action="/cases" method="POST">

<div class="mb-3">
<label>Complainant Name</label>
<input type="text" name="complainant_name" class="form-control" required>
</div>

<div class="mb-3">
<label>Case Title</label>
<input type="text" name="case_title" class="form-control" required>
</div>

<div class="mb-3">
<label>Description</label>
<textarea name="description" class="form-control" rows="5"></textarea>
</div>

<div class="mb-3">
<label>Investigating Officer</label>

<select name="officer" class="form-control">
    <option value="">Select Officer</option>

    <% officers.forEach(officer => { %>
        <option value="<%= officer.full_name %>">
            <%= officer.rank %> - <%= officer.full_name %>
        </option>
    <% }) %>

</select>
</div>

<button class="btn btn-primary">
Save Case
</button>

<a href="/cases" class="btn btn-secondary">
Cancel
</a>

</form>

</div>

</body>
</html>