<!DOCTYPE html>
<html>
<head>
    <title>Arrests</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

    <h2>🚔 Arrest Management</h2>

    <div>

        <a href="/dashboard" class="btn btn-secondary">
            ← Dashboard
        </a>

        <a href="/arrests/new" class="btn btn-primary">
            + New Arrest
        </a>

    </div>

</div>
    <table class="table table-bordered table-hover">

        <thead class="table-dark">
            <tr>
                <th>Arrest No.</th>
                <th>Suspect</th>
                <th>Offence</th>
                <th>Officer</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

        <% if (arrests.length === 0) { %>

            <tr>
                <td colspan="6" class="text-center">
                    No arrests found.
                </td>
            </tr>

        <% } else { %>

            <% arrests.forEach(arrest => { %>

                <tr>

                    <td><%= arrest.arrest_number %></td>

                    <td><%= arrest.suspect_name %></td>

                    <td><%= arrest.offence %></td>

                    <td><%= arrest.arresting_officer %></td>

                    <td><%= arrest.arrest_date %></td>

                    <td>

                        <a href="/arrests/<%= arrest.id %>"
   class="btn btn-info btn-sm">
   View
</a>

                      <a href="/arrests/edit/<%= arrest.id %>"
   class="btn btn-warning btn-sm">
    Edit
</a>

                        <a href="/arrests/delete/<%= arrest.id %>"
   class="btn btn-danger btn-sm"
   onclick="return confirm('Are you sure you want to delete this arrest?')">
    Delete
</a>

                    </td>

                </tr>

            <% }) %>

        <% } %>

        </tbody>

    </table>

</div>

</body>
</html>