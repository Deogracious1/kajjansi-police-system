<!DOCTYPE html>
<html>
<head>
    <title>Kajjansi Police Station Management System</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

       body{
    margin:0;
    background:#edf2f7;
    font-family:Segoe UI,sans-serif;
}

.sidebar{
    background:linear-gradient(180deg,#0b2e59,#114b8b);
    height:100vh;
    position:fixed;
    width:250px;
    left:0;
    top:0;
    color:white;
    box-shadow:0 5px 25px rgba(0,0,0,.2);
    overflow:hidden;
}


.logo{

    text-align:center;

    padding:30px 15px;

    border-bottom:1px solid rgba(255,255,255,.15);

}

.logo img{

    width:90px;

    height:90px;

    object-fit:contain;

    margin-bottom:12px;

}

.logo h4{

    color:white;

    font-weight:bold;

    margin-bottom:5px;

}

.logo p{

    color:#d9e4f5;

    font-size:14px;

    margin:0;

}

.sidebar a{

    display:flex;

    align-items:center;

    color:white;

    text-decoration:none;

    padding:12px 22px;

    margin:4px 10px;

    border-radius:12px;

    transition:.3s;

    font-size:15px;

}

.sidebar a i{

    font-size:20px;

    width:30px;

}

.sidebar a:hover{

    background:rgba(255,255,255,.15);

    transform:translateX(6px);

}

.sidebar a.active{

    background:white;

    color:#0B2E59;

    font-weight:bold;

}

.main{

    margin-left:250px;


}

.topbar{

    background:white;

    padding:18px 35px;

    display:flex;

    justify-content:space-between;

    align-items:center;

    border-bottom:4px solid #FFD200;

    box-shadow:0 5px 18px rgba(0,0,0,.08);

}

.cards{

    padding:40px;

}

.dashboard-card{

    background:white;

    border-radius:15px;

    padding:20px 15px;

    text-align:center;

    transition:.3s;

    box-shadow:0 8px 20px rgba(0,0,0,.08);

    border-top:5px solid #0d6efd;

    height:170px;

}

.dashboard-card:hover{

    transform:translateY(-8px);

}

.dashboard-card h3{

    font-size:32px;

    font-weight:700;

    margin:10px 0 5px;

    color:#0B2E59;

}

.dashboard-card p{

    color:#666;

    font-size:15px;

    margin:0;

}

.primary{

border-top:6px solid #0d6efd;

}

.success{

border-top:6px solid #198754;

}

.warning{

border-top:6px solid orange;

}

.danger{

border-top:6px solid crimson;

}

.panel{

    background:white;

    border-radius:18px;

    padding:25px;

    box-shadow:0 10px 25px rgba(0,0,0,.08);

    min-height:360px;

    transition:.3s;

}

.panel:hover{

    transform:translateY(-5px);

    box-shadow:0 15px 35px rgba(0,0,0,.12);

}

.panel h4{

    color:#0B2E59;

    margin-bottom:25px;

}

.panel p{

    font-size:18px;

    margin-bottom:18px;

}

    </style>
</head>
<body>


<div class="sidebar">

    <div class="logo">

    <img src="/images/police-logo.png" alt="Police Logo">

    <h4>Kajjansi Police</h4>

    <p>Management System</p>

</div>

    <a href="/dashboard" class="active">
        <i class="bi bi-speedometer2"></i>
        Dashboard
    </a>

    <a href="/view-complaints">
        <i class="bi bi-chat-left-text"></i>
        Complaints
    </a>

    <a href="/cases">
        <i class="bi bi-folder2-open"></i>
        Cases
    </a>

    <a href="/officers">
        <i class="bi bi-person-badge"></i>
        Officers
    </a>

    <a href="/arrests">
        <i class="bi bi-shield-lock"></i>
        Arrests
    </a>

    <a href="/visitors">
        <i class="bi bi-people"></i>
        Visitors
    </a>

    <a href="/logout">
    <i class="bi bi-box-arrow-right"></i>
    Logout
</a>

</div>


<div class="main">

    <div class="topbar">

    <div class="d-flex align-items-center">

       <img src="/images/police-logo.png" alt="Police Logo" width="70">

        <div>

            <h3 style="margin:0;font-weight:bold;color:#0B2E59;">
                Kajjansi Police Station
            </h3>

            <small style="color:#666;">
                Police Station Management System
            </small>

        </div>

    </div>

    <div class="text-end">

        <h5 style="margin:0;color:#0B2E59;">
            Welcome,
            <strong><%= user.username %></strong>
        </h5>

        <small id="today"></small>

    </div>

</div>


    <div class="cards">

        <div class="row g-4">

            <div class="col-lg-3">

                <div class="dashboard-card primary">

                    <i class="bi bi-folder-fill"
                       style="font-size:30px;color:#0d6efd;"></i>

                    <h3><%= totalCases %></h3>

                    <p>Total Cases</p>

                </div>

            </div>
            <div class="col-lg-3">

                <div class="dashboard-card danger">

                    <i class="bi bi-exclamation-circle-fill"
                       style="font-size:30px;color:crimson;"></i>

                    <h3><%= totalComplaints %></h3>

                    <p>Complaints</p>

                </div>

            </div>


            <div class="col-lg-3">

                <div class="dashboard-card success">

                    <i class="bi bi-person-badge-fill"
                       style="font-size:30px;color:#198754;"></i>

                    <h3><%= totalOfficers %></h3>

                    <p>Police Officers</p>

                </div>

            </div>


            <div class="col-lg-3">

                <div class="dashboard-card warning">

                    <i class="bi bi-shield-fill-check"
                       style="font-size:30px;color:orange;"></i>

                    <h3><%= totalArrests %></h3>

                    <p>Arrests</p>

                </div>

            </div>

        </div>

    </div>

<div class="cards">

    <div class="row g-4 mt-2">

    <!-- Quick Actions -->
    <div class="col-lg-3">

        <div class="panel">

            <h4>
                <i class="bi bi-lightning-charge-fill"></i>
                Quick Actions
            </h4>

           <a href="/cases/new" class="btn btn-primary w-100 py-3 mb-3">
    <i class="bi bi-folder-plus"></i> New Case
</a>

<a href="/complaints" class="btn btn-danger w-100 py-3 mb-3">
    <i class="bi bi-exclamation-circle"></i> New Complaint
</a>

<a href="/officers/new" class="btn btn-success w-100 py-3 mb-3">
    <i class="bi bi-person-plus"></i> Register Officer
</a>

<a href="/arrests/new" class="btn btn-warning w-100 py-3">
    <i class="bi bi-shield-plus"></i> New Arrest
</a>

        </div>

    </div>


    <!-- Date & Time -->

    <div class="col-lg-5">

        <div class="panel text-center">

            <h4>
                <i class="bi bi-calendar-event"></i>
                Current Date
            </h4>

            <h2 id="currentDate"></h2>

            <hr>

            <h1 id="currentTime"></h1>

        </div>

    </div>


    <!-- System Overview -->
<div class="col-lg-3">

    <div class="panel">

        <h4>
            <i class="bi bi-bar-chart-fill"></i>
            System Overview
        </h4>

        <p>👮 Officers : <strong><%= totalOfficers %></strong></p>

        <p>📁 Cases : <strong><%= totalCases %></strong></p>

        <p>🚔 Arrests : <strong><%= totalArrests %></strong></p>

        <p>⚠ Complaints : <strong><%= totalComplaints %></strong></p>

    </div>

</div>

<!-- Recent Activity -->
<div class="card mt-4">
    <div class="card-header">
        <h5>Recent Activities</h5>
    </div>

    <div class="card-body">

        <% if (activities.length === 0) { %>

            <p>No recent activities.</p>

        <% } else { %>

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Activity</th>
                        <th>User</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody>

                <% activities.forEach(activity => { %>

                    <tr>
                        <td><%= activity.activity %></td>
                        <td><%= activity.officer %></td>
                        <td><%= activity.created_at %></td>
                    </tr>

                <% }) %>

                </tbody>

            </table>

        <% } %>

    </div>
</div>
    </div>

</div>

    </div>

</div>
</div> <!-- row -->

</div> <!-- cards -->
<script>

function updateClock(){

    const now = new Date();

    document.getElementById("currentDate").innerHTML =
        now.toDateString();

    document.getElementById("currentTime").innerHTML =
        now.toLocaleTimeString();

    document.getElementById("today").innerHTML =
        now.toLocaleDateString();

}

setInterval(updateClock,1000);

updateClock();

</script>

</body>