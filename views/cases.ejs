<!DOCTYPE html>
<html>
<head>
    <title>Cases</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

<h2>Police Cases</h2>

<a href="/dashboard" class="btn btn-secondary mb-3">
    Dashboard
</a>

<a href="/cases/new" class="btn btn-primary mb-3">
    New Case
</a>

<table class="table table-bordered">

<tr>
<th>Case No.</th>
<th>Complainant</th>
<th>Title</th>
<th>Officer</th>
<th>Status</th>
<th>Date</th>
<th>Actions</th>
</tr>

<% cases.forEach(c => { %>

<tr>
<td><%= c.case_number %></td>
<td><%= c.complainant_name %></td>
<td><%= c.case_title %></td>
<td><%= c.officer %></td>
<td><%= c.status %></td>
<td><%= c.created_at %></td>

<td>
    <a href="/cases/edit/<%= c.id %>"
       class="btn btn-sm btn-warning">
       Edit
    </a>

    <a href="/cases/delete/<%= c.id %>"
       class="btn btn-sm btn-danger"
       onclick="return confirm('Delete this case?')">
       Delete
    </a>
</td>
</tr>

<% }) %>

</table>

</div>

</body>
</html>