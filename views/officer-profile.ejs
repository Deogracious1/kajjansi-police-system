<!DOCTYPE html>
<html>
<head>
<style>
.profile-pic{
    width:200px;
    height:200px;
    border-radius:50%;
    object-fit:cover;
    object-position:center;
    border:4px solid #0d6efd;
}
</style>
<title>Officer Profile</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

<a href="/officers" class="btn btn-secondary mb-3">
Back to Officers
</a>

<div class="card p-4">

<div class="text-center">

<% if (officer.photo) { %>

<img
src="<%= officer.photo %>"
class="profile-pic">
<% } %>

<h2 class="mt-3">
<%= officer.rank %> <%= officer.full_name %>
</h2>

<p><strong>Badge:</strong> <%= officer.badge_number %></p>
<p><strong>Department:</strong> <%= officer.department %></p>
<p><strong>Phone:</strong> <%= officer.phone %></p>

</div>

<hr>

<h4>Assigned Cases</h4>

<table class="table table-bordered">

<tr>
<th>Case Number</th>
<th>Title</th>
<th>Status</th>
</tr>

<% cases.forEach(c => { %>

<tr>
<td><%= c.case_number %></td>
<td><%= c.case_title %></td>
<td><%= c.status %></td>
</tr>

<% }) %>

</table>

</div>

</div>

</body>
</html>