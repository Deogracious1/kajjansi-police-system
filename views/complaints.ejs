<!DOCTYPE html>
<html>
<head>
    <nav class="navbar navbar-dark bg-primary mb-4">
  <div class="container-fluid">
    <span class="navbar-brand">
      🚔 Kajjansi Police Management System
    </span>

    <div>
      <a href="/dashboard" class="btn btn-light me-2">
        Dashboard
      </a>

      <a href="/logout" class="btn btn-danger">
        Logout
      </a>
    </div>
  </div>
</nav>

    <title>Complaints</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

<h2>Register Complaint</h2>

<form action="/complaints" method="POST">

<div class="mb-3">
<label>Complainant Name</label>
<input type="text" name="name" class="form-control" required>
</div>

<div class="mb-3">
<label>Phone Number</label>
<input type="text" name="phone" class="form-control">
</div>

<div class="mb-3">
<label>Complaint</label>
<textarea name="complaint" class="form-control" rows="5" required></textarea>
</div>

<button class="btn btn-primary">
Save Complaint
</button>

<a href="/view-complaints" class="btn btn-secondary">
    View Complaints
</a>


</form>

</div>

</body>
</html>