<!DOCTYPE html>
<html>
<head>
<title>Edit Case</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

<h2>Edit Case</h2>

<form action="/cases/update/<%= policeCase.id %>" method="POST">

<div class="mb-3">
<label>Complainant Name</label>
<input
type="text"
name="complainant_name"
class="form-control"
value="<%= policeCase.complainant_name %>"
required>
</div>

<div class="mb-3">
<label>Case Title</label>
<input
type="text"
name="case_title"
class="form-control"
value="<%= policeCase.case_title %>"
required>
</div>

<div class="mb-3">
<label>Description</label>
<textarea
name="description"
class="form-control"
rows="5"><%= policeCase.description %></textarea>
</div>

<div class="mb-3">
<label>Investigating Officer</label>

<select name="officer" class="form-control">

<% officers.forEach(officer => { %>

<option
value="<%= officer.full_name %>"
<%= policeCase.officer === officer.full_name ? 'selected' : '' %>>
    <%= officer.rank %> - <%= officer.full_name %>
</option>

<% }) %>

</select>

</div>

<div class="mb-3">
<label>Status</label>
<select name="status" class="form-control">
    <option value="Open" <%= policeCase.status === 'Open' ? 'selected' : '' %>>
        Open
    </option>
    <option value="Under Investigation" <%= policeCase.status === 'Under Investigation' ? 'selected' : '' %>>
        Under Investigation
    </option>
    <option value="Closed" <%= policeCase.status === 'Closed' ? 'selected' : '' %>>
        Closed
    </option>
</select>
</div>

<button class="btn btn-primary">
Update Case
</button>

<a href="/cases" class="btn btn-secondary">
Cancel
</a>

</form>

</div>

</body>
</html>