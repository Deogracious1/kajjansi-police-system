<!DOCTYPE html>
<html>
<head>

<title>Edit Arrest</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

</head>

<body>

<div class="container mt-5">

<h2>Edit Arrest</h2>

<form action="/arrests/update/<%= arrest.id %>" method="POST">

<div class="mb-3">
<label>Suspect Name</label>
<input
type="text"
name="suspect_name"
class="form-control"
value="<%= arrest.suspect_name %>"
required>
</div>

<div class="mb-3">
<label>National ID</label>
<input
type="text"
name="national_id"
class="form-control"
value="<%= arrest.national_id %>">
</div>

<div class="mb-3">
<label>Gender</label>

<select name="gender" class="form-control">

<option value="Male" <%= arrest.gender=="Male"?"selected":"" %>>
Male
</option>

<option value="Female" <%= arrest.gender=="Female"?"selected":"" %>>
Female
</option>

</select>

</div>

<div class="mb-3">
<label>Age</label>

<input
type="number"
name="age"
class="form-control"
value="<%= arrest.age %>">

</div>

<div class="mb-3">
<label>Phone</label>

<input
type="text"
name="phone"
class="form-control"
value="<%= arrest.phone %>">

</div>

<div class="mb-3">
<label>Address</label>

<input
type="text"
name="address"
class="form-control"
value="<%= arrest.address %>">

</div>

<div class="mb-3">
<label>Offence</label>

<input
type="text"
name="offence"
class="form-control"
value="<%= arrest.offence %>">

</div>

<div class="mb-3">
<label>Case Number</label>

<select name="case_number" class="form-control">

<% cases.forEach(function(c){ %>

<option
value="<%= c.case_number %>"
<%= arrest.case_number==c.case_number ? "selected":"" %>>

<%= c.case_number %>

</option>

<% }) %>

</select>

</div>

<div class="mb-3">

<label>Arrest Date</label>

<input
type="date"
name="arrest_date"
class="form-control"
value="<%= arrest.arrest_date %>">

</div>

<div class="mb-3">

<label>Arrest Time</label>

<input
type="time"
name="arrest_time"
class="form-control"
value="<%= arrest.arrest_time %>">

</div>

<div class="mb-3">

<label>Location</label>

<input
type="text"
name="arrest_location"
class="form-control"
value="<%= arrest.arrest_location %>">

</div>

<div class="mb-3">

<label>Arresting Officer</label>

<select
name="arresting_officer"
class="form-control">

<% officers.forEach(function(o){ %>

<option
value="<%= o.full_name %>"
<%= arrest.arresting_officer==o.full_name ? "selected":"" %>>

<%= o.full_name %>

</option>

<% }) %>

</select>

</div>

<div class="mb-3">

<label>Cell Number</label>

<input
type="text"
name="cell_number"
class="form-control"
value="<%= arrest.cell_number %>">

</div>

<div class="mb-3">

<label>Remarks</label>

<textarea
name="remarks"
class="form-control"><%= arrest.remarks %></textarea>

</div>

<button class="btn btn-primary">
Update Arrest
</button>

<a href="/arrests" class="btn btn-secondary">
Cancel
</a>

</form>

</div>

</body>
</html>