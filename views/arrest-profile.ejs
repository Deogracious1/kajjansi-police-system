<!DOCTYPE html>
<html>
<head>
    <title>Arrest Details</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body>

<div class="container mt-5">

    <h2>Arrest Details</h2>

    <table class="table table-bordered">

        <tr>
            <th>Arrest Number</th>
            <td><%= arrest.arrest_number %></td>
        </tr>

        <tr>
            <th>Suspect Name</th>
            <td><%= arrest.suspect_name %></td>
        </tr>

        <tr>
            <th>National ID</th>
            <td><%= arrest.national_id %></td>
        </tr>

        <tr>
            <th>Gender</th>
            <td><%= arrest.gender %></td>
        </tr>

        <tr>
            <th>Age</th>
            <td><%= arrest.age %></td>
        </tr>

        <tr>
            <th>Phone</th>
            <td><%= arrest.phone %></td>
        </tr>

        <tr>
            <th>Address</th>
            <td><%= arrest.address %></td>
        </tr>

        <tr>
            <th>Offence</th>
            <td><%= arrest.offence %></td>
        </tr>

        <tr>
            <th>Case Number</th>
            <td><%= arrest.case_number %></td>
        </tr>

        <tr>
            <th>Arrest Date</th>
            <td><%= arrest.arrest_date %></td>
        </tr>

        <tr>
            <th>Arrest Time</th>
            <td><%= arrest.arrest_time %></td>
        </tr>

        <tr>
            <th>Location</th>
            <td><%= arrest.arrest_location %></td>
        </tr>

        <tr>
            <th>Arresting Officer</th>
            <td><%= arrest.arresting_officer %></td>
        </tr>

        <tr>
            <th>Cell Number</th>
            <td><%= arrest.cell_number %></td>
        </tr>

        <tr>
            <th>Remarks</th>
            <td><%= arrest.remarks %></td>
        </tr>

    </table>

    <a href="/arrests" class="btn btn-secondary">
        Back
    </a>

    <a href="/officers" class="btn btn-primary">
        Dashboard
    </a>

</div>

</body>
</html>