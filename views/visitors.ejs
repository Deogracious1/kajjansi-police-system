<!DOCTYPE html>
<html>
<head>
    <title>Visitors</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet">
</head>
<body>

<div class="container mt-5">

    <h2>Visitors</h2>

    <a href="/visitors/new" class="btn btn-primary mb-3">
        Register Visitor
    </a>

    <a href="/dashboard" class="btn btn-secondary mb-3">
        Back to Dashboard
    </a>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>ID</th>
                <th>Visitor No.</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Person to Visit</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

        <% visitors.forEach(function(visitor){ %>

            <tr>
                <td><%= visitor.id %></td>
                <td><%= visitor.visitor_number %></td>
                <td><%= visitor.full_name %></td>
                <td><%= visitor.phone %></td>
                <td><%= visitor.person_to_visit %></td>
                <td><%= visitor.date %></td>

                <td>
                    <a href="/visitors/edit/<%= visitor.id %>"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a href="/visitors/delete/<%= visitor.id %>"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>

        <% }) %>

        </tbody>

    </table>

</div>

</body>
</html>